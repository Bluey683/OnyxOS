<Page
    x:Class="OnyxOS.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080D14">
    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock Text="ONYXOS • INSTALADOR" Foreground="#F4F7FB"
                       FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstallerSubtitle" Text="Preparando instalação pelo ISO"
                       Foreground="#91A2B8" FontSize="16"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#020407" BorderBrush="#26364B" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <Grid x:Name="GuestHost"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Spacing="14">
                <TextBlock Text="Instalação do sistema" Foreground="#F4F7FB"
                           FontSize="25" FontWeight="SemiBold"/>
                <ProgressBar x:Name="InstallProgress" IsIndeterminate="True"
                             Height="12" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="InstallStatus"
                           Text="O instalador do sistema está sendo executado na máquina virtual."
                           Foreground="#DCE6F2" FontSize="17" TextWrapping="Wrap"/>
                <TextBlock Text="O QEMU não fornece uma porcentagem confiável da instalação. A barra indica atividade; confirme somente depois que o instalador terminar e a máquina desligar."
                           Foreground="#91A2B8" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button x:Name="StopInstallerButton" Content="Parar QEMU"
                    MinWidth="150" Click="StopInstallerButton_Click"/>
            <Button x:Name="FinishInstallerButton" Content="Instalação concluída"
                    MinWidth="200" IsEnabled="False" Click="FinishInstallerButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
