<Page
    x:Class="OnyxOS.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#020407">
    <Grid x:Name="PageRoot" Background="#020407">
        <!-- O vídeo do instalador ocupa a tela inteira desde o início. -->
        <Grid x:Name="GuestHost" HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"/>

        <TextBox x:Name="KeyboardSink" Width="1" Height="1" Opacity="0"
                 IsTabStop="True" IsReadOnly="True"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Border x:Name="HeaderPanel" VerticalAlignment="Top"
                Background="#DD111C2A" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="ONYXOS • INSTALADOR" Foreground="#F4F7FB"
                               FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="A imagem da máquina virtual ocupa a tela inteira."
                               Foreground="#91A2B8" FontSize="14"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Tela cheia"
                        Click="FullScreenButton_Click"
                        VerticalAlignment="Center" MinWidth="150"/>
            </Grid>
        </Border>

        <Button x:Name="ShowControlsButton" Content="Mostrar controles"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16" Visibility="Visible" Click="ShowControlsButton_Click"/>

        <Border x:Name="FooterPanel" VerticalAlignment="Bottom"
                Background="#DD111C2A" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5" MaxWidth="850">
                    <ProgressBar x:Name="InstallProgress" IsIndeterminate="True"
                                 Height="8" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="InstallStatus"
                               Text="Preparando a máquina virtual..."
                               Foreground="#DCE6F2" FontSize="15"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="10">
                    <Button x:Name="StopInstallerButton" Content="Parar QEMU"
                            MinWidth="140" Click="StopInstallerButton_Click"/>
                    <Button x:Name="FinishInstallerButton" Content="Instalação concluída"
                            MinWidth="190" IsEnabled="False"
                            Click="FinishInstallerButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
