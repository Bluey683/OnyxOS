<Page
    x:Class="OnyxOS.GuestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#020407">
    <Grid Background="#020407">
        <!-- SwapChainPanel usa toda a área disponível da tela do Xbox. -->
        <SwapChainPanel x:Name="QemuSurface"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
        <TextBox x:Name="KeyboardSink" Width="1" Height="1" Opacity="0"
                 IsTabStop="True" IsReadOnly="True"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel x:Name="NoFramePanel" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="10" MaxWidth="700">
            <TextBlock Text="QEMU DISPLAY" Foreground="#6F829B"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DisplayStatus"
                       Text="Aguardando o framebuffer do QEMU..."
                       Foreground="#DCE6F2" FontSize="26"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Border x:Name="HeaderPanel" VerticalAlignment="Top"
                Background="#DD111C2A" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="GuestTitle" Text="ONYXOS • QEMU"
                               Foreground="#F4F7FB" FontSize="23"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="GuestSubtitle" Text="Máquina virtual"
                               Foreground="#91A2B8" FontSize="14"/>
                    <TextBlock x:Name="RendererLabel" Text="Direct3D 11 / HLSL"
                               Foreground="#9CCBFF" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="8">
                    <Button Content="Tela cheia" Click="FullScreenButton_Click"
                            MinWidth="140"/>
                    <Button x:Name="StopButton" Content="Parar"
                            IsEnabled="False" Click="StopButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="ShowControlsButton" Content="Mostrar controles"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16" Visibility="Collapsed"
                Click="ShowControlsButton_Click"/>

        <Border x:Name="FooterPanel" VerticalAlignment="Bottom"
                Background="#DD111C2A" Padding="16,8">
            <TextBlock x:Name="ConnectionStatus"
                       Text="QEMU: aguardando inicialização"
                       Foreground="#DCE6F2" FontSize="13"/>
        </Border>
    </Grid>
</Page>
