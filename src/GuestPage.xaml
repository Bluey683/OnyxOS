<Page
    x:Class="OnyxOS.GuestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080D14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="18,12" Background="#111C2A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Name="GuestTitle" Text="ONYXOS • QEMU"
                           Foreground="#F4F7FB" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="GuestSubtitle" Text="Máquina virtual"
                           Foreground="#91A2B8" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Border Background="#26364B" CornerRadius="8" Padding="10,6">
                    <TextBlock x:Name="RendererLabel" Text="HLSL / Direct3D 11"
                               Foreground="#9CCBFF" FontSize="12"/>
                </Border>
                <Button x:Name="StopButton" Content="Parar" IsEnabled="False"
                        Click="StopButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="14" Background="#020407">
            <Border BorderBrush="#26364B" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <SwapChainPanel x:Name="QemuSurface"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                    <StackPanel x:Name="NoFramePanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="10"
                                MaxWidth="460">
                        <TextBlock Text="QEMU DISPLAY" Foreground="#6F829B"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DisplayStatus"
                                   Text="Aguardando o framebuffer do QEMU..."
                                   Foreground="#DCE6F2" FontSize="18"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="A superfície gráfica será apresentada aqui."
                                   Foreground="#718198" FontSize="12"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="18,10" Background="#111C2A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ConnectionStatus" Text="QEMU: aguardando inicialização"
                       Foreground="#91A2B8" FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="TECLADO • MOUSE • CONTROLE • ÁUDIO"
                       Foreground="#718198" FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
