<Page
    x:Class="OnyxOS.LauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0B1018">

    <Page.Resources>
        <Style x:Key="ProfileCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#142031"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#293B50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="142"/>
        </Style>
    </Page.Resources>
\n    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="ONYXOS" Foreground="#F4F7FB" FontSize="32"
                           FontWeight="Bold" CharacterSpacing="180"/>
                <TextBlock Text="VIRTUAL MACHINE CENTER" Foreground="#8B9AAF"
                           FontSize="12" CharacterSpacing="120"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#172333" CornerRadius="12"
                    Padding="16,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="#E5A93D"/>
                    <TextBlock Text="EARLY ACCESS" Foreground="#E5B85F"
                               FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,18" Spacing="5">
                <TextBlock Text="Escolha seu sistema" Foreground="#F4F7FB"
                           FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Selecione um perfil para preparar sua máquina virtual."
                           Foreground="#9AA9BC" FontSize="14"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Windows10Card" Grid.Row="0" Grid.Column="0"
                            Tag="windows10" Click="ProfileCard_Click" Style="{StaticResource ProfileCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="▦" FontSize="32" Foreground="#69A7F8"/>
                            <TextBlock Text="Windows 10" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Microsoft Windows" FontSize="12" Foreground="#9AA9BC"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Windows11Card" Grid.Row="0" Grid.Column="1"
                            Tag="windows11" Click="ProfileCard_Click" Style="{StaticResource ProfileCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="▦" FontSize="32" Foreground="#72B7F4"/>
                            <TextBlock Text="Windows 11" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Microsoft Windows" FontSize="12" Foreground="#9AA9BC"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DebianCard" Grid.Row="0" Grid.Column="2"
                            Tag="debian" Click="ProfileCard_Click" Style="{StaticResource ProfileCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="◉" FontSize="32" Foreground="#E56C83"/>
                            <TextBlock Text="Debian" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Linux distribution" FontSize="12" Foreground="#9AA9BC"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UbuntuCard" Grid.Row="1" Grid.Column="0"
                            Tag="ubuntu" Click="ProfileCard_Click" Style="{StaticResource ProfileCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="●" FontSize="32" Foreground="#E78B55"/>
                            <TextBlock Text="Ubuntu" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Linux distribution" FontSize="12" Foreground="#9AA9BC"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ArchLinuxCard" Grid.Row="1" Grid.Column="1"
                            Tag="archlinux" Click="ProfileCard_Click" Style="{StaticResource ProfileCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="▲" FontSize="32" Foreground="#66B9E8"/>
                            <TextBlock Text="Arch Linux" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Linux distribution" FontSize="12" Foreground="#9AA9BC"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MacOSCard" Grid.Row="1" Grid.Column="2"
                            Tag="macos" Click="ProfileCard_Click" Style="{StaticResource ProfileCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="●" FontSize="32" Foreground="#C8D0DA"/>
                            <TextBlock Text="macOS" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Experimental profile" FontSize="12" Foreground="#E5B85F"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#111C2A" CornerRadius="12"
                    Padding="16" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SelectionTitle" Text="Nenhum sistema selecionado"
                                   Foreground="#F4F7FB" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Selecione um perfil. A inicialização de VMs ainda não está disponível."
                                   Foreground="#9AA9BC" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="LaunchButton" Grid.Column="1" Content="Iniciar máquina virtual"
                            IsEnabled="False" MinWidth="220" VerticalAlignment="Center"
                            Click="LaunchButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="ONYXOS • QEMU HOST" Foreground="#65758A" FontSize="11"
                       VerticalAlignment="Center"/>
            <TextBlock Text="ISO  /  VHDX  /  CONFIGURAÇÕES"
                       Foreground="#65758A" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>

</Page>
