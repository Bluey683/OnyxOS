<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap">
  <Identity Name="Bluey683.OnyxOS" Publisher="CN=Bluey683" Version="0.2.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>OnyxOS</DisplayName>
    <PublisherDisplayName>Team Onyx</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources><Resource Language="pt-BR" /></Resources>
  <Applications>
    <Application Id="Launcher" Executable="OnyxOS-Launcher.exe">
      <uap:VisualElements DisplayName="OnyxOS Launcher" Description="Launcher principal do OnyxOS" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
    <Application Id="Windows10" Executable="OnyxOS-Windows10.exe">
      <uap:VisualElements DisplayName="OnyxOS - Windows 10" Description="Perfil de máquina virtual Windows 10" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <Application Id="Windows11" Executable="OnyxOS-Windows11.exe">
      <uap:VisualElements DisplayName="OnyxOS - Windows 11" Description="Perfil de máquina virtual Windows 11" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <Application Id="Debian" Executable="OnyxOS-Debian.exe">
      <uap:VisualElements DisplayName="OnyxOS - Debian" Description="Perfil de máquina virtual Debian" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <Application Id="Ubuntu" Executable="OnyxOS-Ubuntu.exe">
      <uap:VisualElements DisplayName="OnyxOS - Ubuntu" Description="Perfil de máquina virtual Ubuntu" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <Application Id="ArchLinux" Executable="OnyxOS-ArchLinux.exe">
      <uap:VisualElements DisplayName="OnyxOS - Arch Linux" Description="Perfil de máquina virtual Arch Linux" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <Application Id="macOS" Executable="OnyxOS-macOS.exe">
      <uap:VisualElements DisplayName="OnyxOS - macOS Experimental" Description="Perfil experimental de máquina virtual macOS" BackgroundColor="#101820" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
